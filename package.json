    "@solana/web3.js": "^1.99.0",
    "arctic": "^3.7.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "motion": "^13.4.1",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
