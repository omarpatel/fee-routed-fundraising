# --- Database (libsql) ---------------------------------------------------------
# Local file by default; a Turso `libsql://…` URL in production.
DATABASE_URL=file:./data/fee-router.db
# Turso auth token (leave empty for a local file).
DATABASE_AUTH_TOKEN=
# Uploads, receipt evidence and verification briefs. Empty = the directory of the SQLite file above
# (./data locally, the /data volume on Railway), so files persist exactly as long as the database.
DATA_DIR=

# --- Custody -------------------------------------------------------------------
# 32-byte hex key that encrypts custodial secrets (treasury, route, anchor signer) at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEE_ROUTER_KMS_KEY=

# --- Solana --------------------------------------------------------------------
# Write-capable RPC (Helius/Triton/etc). Unset → public mainnet, reads only; anchoring/sweeps/transfers are off.
SOLANA_RPC_URL=
# Helius API key for registering the enhanced-transaction webhook on route addresses.
HELIUS_API_KEY=
# Shared secret Helius sends in the Authorization header of every webhook POST.
HELIUS_WEBHOOK_SECRET=
# Jupiter API key (api.jup.ag) for price lookups and route→USDC swaps.
JUPITER_API_KEY=

# --- Launchpads ----------------------------------------------------------------
# Bags API key (dev.bags.fm) for fee-share configs and token launches.
BAGS_API_KEY=

# --- Auth (Google, direct) -----------------------------------------------------
# OAuth 2.0 web client from console.cloud.google.com. Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Second OAuth client from a Testing-mode project (Google blocks restricted Gmail scopes on unverified
# production apps). Used only for the operator "Connect Gmail" flow; test users = operator emails.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# 32+ random chars; signs session cookies.
SESSION_SECRET=
# Comma-separated emails that get the `operator` / `admin` role at sign-in (never demoted).
OPERATOR_EMAILS=
ADMIN_EMAILS=
# Local demo only (ignored in production): act as this seeded user without Google.
# `ops@example.com` is the operator created by `pnpm db:seed`.
FEE_ROUTER_DEV_SESSION_EMAIL=

# --- Site ----------------------------------------------------------------------
# Public origin; used for the Helius webhook URL and absolute links in receipts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Rails (Zentro card) -------------------------------------------------------
# CardHub login used for automatic re-login when the imported session expires.
ZENTRO_USERNAME=
ZENTRO_PASSWORD=
# Optional: card id (from /admin → Zentro); first card is used otherwise.
ZENTRO_CARD_ID=

# --- Wallet --------------------------------------------------------------------
# Per-transaction cap for custodial withdrawals, USD.
WALLET_WITHDRAW_MAX_USD=5000

# --- Claude (assistive only) ---------------------------------------------------
# Anthropic API key. Powers the fundraiser fact-check brief on the operator desk, "Suggest edits"
# on the fundraiser story, and the plain-English rationale on reconciled deliveries. Verification
# decisions are always made by a human; nothing is approved automatically. Unset → those buttons
# report "Claude not configured".
ANTHROPIC_API_KEY=
# Model id; defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=
